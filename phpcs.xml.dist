<?xml version="1.0" encoding="UTF-8"?>

<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="PSR12"/>

    <!-- File header: declare(strict_types=1) is mandatory -->
    <rule ref="Generic.PHP.RequireStrictTypes"/>

    <!-- Classes: one class per file, file named after the class -->
    <rule ref="Generic.Files.OneObjectStructurePerFile"/>
    <rule ref="Squiz.Classes.ClassFileName"/>

    <!-- Constants: UPPER_SNAKE_CASE (visibility is already enforced by PSR12) -->
    <rule ref="Generic.NamingConventions.UpperCaseConstantName"/>

    <!-- Naming: Interface / Trait suffixes and Abstract prefix (methods are camelCase via PSR1) -->
    <rule ref="Generic.NamingConventions.InterfaceNameSuffix"/>
    <rule ref="Generic.NamingConventions.TraitNameSuffix"/>
    <rule ref="Generic.NamingConventions.AbstractClassNamePrefix"/>

    <!-- Naming: camelCase properties and variables, no underscore prefix on private members -->
    <rule ref="Squiz.NamingConventions.ValidVariableName">
        <exclude name="Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore"/>
    </rule>

    <!-- Strings: single quotes unless the string needs escapes or interpolation -->
    <rule ref="Squiz.Strings.DoubleQuoteUsage">
        <exclude name="Squiz.Strings.DoubleQuoteUsage.ContainsVar"/>
    </rule>

    <!-- Arrays: short syntax only -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- Debug helpers: warn only -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="error" value="false"/>
            <property name="forbiddenFunctions" type="array">
                <element key="var_dump" value="null"/>
                <element key="dd" value="null"/>
                <element key="dump" value="null"/>
                <element key="print_r" value="null"/>
            </property>
        </properties>
    </rule>

    <file>bin/</file>
    <file>config/</file>
    <file>public/</file>
    <file>src/</file>
    <file>tests/</file>

    <!-- Generated / recipe-managed files -->
    <exclude-pattern>config/reference\.php$</exclude-pattern>
    <exclude-pattern>config/bundles\.php$</exclude-pattern>

</ruleset>
